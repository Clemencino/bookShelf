{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "types":["node"],
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2022",
    "module": "esnext",
    "lib": ["es2020", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "paths": {
      "@org/api/products": ["./packages/api/products/src/index.ts"],
      "@org/models": ["./packages/shared/models/src/index.ts"],
      "@org/shop/data": ["./packages/shop/data/src/index.ts"],
      "@org/shop/feature-product-detail": [
        "./packages/shop/feature-product-detail/src/index.ts"
      ],
      "@org/shop/feature-products": [
        "./packages/shop/feature-products/src/index.ts"
      ],
      "@org/shop/shared-ui": ["./packages/shop/shared-ui/src/index.ts"],
      "@org/booklib": ["./libs/booklib/src/lib/booklib.ts"],
      "@org/userlib": ["./libs/booklib/src/lib/userlib.ts"],
      "@org/storelib": ["./libs/booklib/src/lib/storelib.ts"]

    }
  },
  "exclude": ["node_modules", "tmp"]
}
